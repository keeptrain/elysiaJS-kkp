{
  "name": "elysiajs-kkp",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile server src/index.ts",
    "sync:types": "bun scripts/sync-frontend-types.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seeder.ts",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "check": "biome check src"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "openapi-types": "12.1.3",
    "@biomejs/biome": "^2.5.14"
  },
  "module": "src/index.js"
}
